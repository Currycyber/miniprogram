/* pages/admin-login/admin-login.wxss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #26215C 0%, #534ab7 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

.login-brand {
  text-align: center;
  color: #fff;
  margin-bottom: 60rpx;
}
.brand-icon {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  color: #26215C;
  border-radius: 24rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 120rpx;
  margin: 0 auto 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}
.brand-name {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.brand-sub {
  font-size: 24rpx;
  opacity: 0.85;
}

.login-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.form-item {
  margin-bottom: 36rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #2c2c2a;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-input-wrap {
  position: relative;
}
.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.form-placeholder {
  color: #b0b0b0;
  font-size: 28rpx;
}
.form-eye {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  padding: 8rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #26215C;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
  transition: opacity 0.2s;
}
.login-btn::after {
  border: none;
}
.login-btn.disabled {
  opacity: 0.7;
}

.form-hint {
  text-align: center;
  font-size: 24rpx;
  color: #888780;
  margin-top: 24rpx;
  padding: 8rpx;
}

.login-footer {
  margin-top: 60rpx;
  color: #fff;
  font-size: 26rpx;
  opacity: 0.85;
  padding: 16rpx;
}