/* pages/admin-params/admin-params.wxss */

.admin-bg {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 16rpx 80rpx;
  box-sizing: border-box;
}

/* 顶部欢迎条 */
.admin-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #26215C, #534ab7);
  color: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}
.admin-greet { display: flex; align-items: center; gap: 14rpx; }
.admin-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  text-align: center;
  line-height: 64rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.admin-name { font-size: 30rpx; font-weight: 600; }
.admin-role { font-size: 20rpx; opacity: 0.85; margin-top: 4rpx; }
.admin-actions { display: flex; gap: 16rpx; }
.admin-action {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2c2a;
  margin-bottom: 16rpx;
}
.weight-sum {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.weight-sum.ok { background: #e8f7ee; color: #07c160; }
.weight-sum.err { background: #fdecec; color: #e64340; }

/* 五育权重行 */
.weight-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.weight-row:last-child { border-bottom: none; }
.weight-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 130rpx;
  flex-shrink: 0;
}
.weight-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}
.weight-name { font-size: 24rpx; color: #2c2c2a; }
.weight-control { flex: 1; }
.weight-value {
  width: 70rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #26215C;
  flex-shrink: 0;
}
.weight-warn {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  background: #fdecec;
  border-left: 6rpx solid #e64340;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #b71c1c;
}

/* 加分上限行 */
.limit-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.limit-row:last-child { border-bottom: none; }
.limit-label {
  width: 280rpx;
  font-size: 24rpx;
  color: #2c2c2a;
  flex-shrink: 0;
}
.limit-control { flex: 1; }
.limit-value {
  width: 90rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF9500;
  flex-shrink: 0;
}

/* 加减分规则 */
.rule-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.rule-row:last-child { border-bottom: none; }
.rule-cat {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: #fff;
  flex-shrink: 0;
}
.rule-cat.rule-moral { background: #534ab7; }
.rule-cat.rule-intellectual { background: #1989fa; }
.rule-cat.rule-physical { background: #07c160; }
.rule-cat.rule-aesthetic { background: #FF9500; }
.rule-cat.rule-labor { background: #9c27b0; }
.rule-cat.rule-dorm { background: #e64340; }
.rule-name {
  flex: 1;
  font-size: 24rpx;
  color: #2c2c2a;
  min-width: 0;
}
.rule-score {
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.rule-score.add { color: #07c160; }
.rule-score.deduct { color: #e64340; }

/* 修改历史 */
.hist-row {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.hist-row:last-child { border-bottom: none; }
.hist-time {
  font-size: 20rpx;
  color: #888780;
  width: 220rpx;
  flex-shrink: 0;
}
.hist-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.hist-operator {
  font-size: 20rpx;
  color: #534ab7;
  font-weight: 600;
}
.hist-desc {
  font-size: 22rpx;
  color: #2c2c2a;
  line-height: 1.5;
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}
.btn-reset, .btn-save {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.btn-reset {
  background: #fff;
  color: #888780;
  border: 2rpx solid #ddd;
}
.btn-save {
  background: #26215C;
  color: #fff;
}
.btn-save.disabled {
  opacity: 0.5;
  background: #b0b0b0;
}

.admin-footer {
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 32rpx;
}