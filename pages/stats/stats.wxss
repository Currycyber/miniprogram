.overview-card {
  background: #26215c;
  border-radius: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.overview-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.overview-num {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
  margin-top: 12rpx;
}

.overview-meta {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* ===== 学年切换器 ===== */
.year-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.year-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 24rpx;
  color: #888780;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.year-tab-hover {
  background: #f5f5fa;
}
.year-tab.active {
  background: #26215C;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(38, 33, 92, 0.3);
}

/* ===== 学院柱状图行（可点击） ===== */
.college-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.15s;
}
.college-row:last-child {
  border-bottom: none;
}
.college-row-hover {
  background: #f5f5fa;
}
.college-row.highlighted {
  background: #fff8ed;
}
.college-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 240rpx;
  flex-shrink: 0;
}
.college-rank {
  width: 36rpx;
  height: 36rpx;
  background: #f0f0f0;
  color: #888780;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.college-row.highlighted .college-rank {
  background: #FF9500;
  color: #fff;
}
.college-name {
  font-size: 24rpx;
  color: #2c2c2a;
}
.college-name.highlighted {
  color: #26215C;
  font-weight: 600;
}
.college-bar {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}
.college-fill {
  height: 100%;
  background: linear-gradient(90deg, #534ab7, #26215C);
  border-radius: 8rpx;
  transition: width 0.4s ease, background 0.2s;
}
.college-fill.highlighted {
  background: linear-gradient(90deg, #FF9500, #FF6B00);
  box-shadow: 0 0 8rpx rgba(255, 149, 0, 0.5);
}
.college-score {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c2c2a;
  flex-shrink: 0;
}

/* ===== 雷达图 ===== */
.radar-card {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx;
}

.radar-canvas {
  width: 500rpx;
  height: 380rpx;
}

/* ===== 已选学院提示（点击重置） ===== */
.selection-tip {
  background: #fff8ed;
  border-left: 6rpx solid #FF9500;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #6b4400;
}
.selection-tip text {
  display: block;
}