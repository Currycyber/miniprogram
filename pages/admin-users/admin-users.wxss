/* pages/admin-users/admin-users.wxss */

.admin-bg {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 16rpx 80rpx;
  box-sizing: border-box;
}

/* 顶部欢迎条 */
.admin-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #26215C, #534ab7);
  color: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}
.admin-greet { display: flex; align-items: center; gap: 14rpx; }
.admin-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  text-align: center;
  line-height: 64rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.admin-name { font-size: 30rpx; font-weight: 600; }
.admin-role { font-size: 20rpx; opacity: 0.85; margin-top: 4rpx; }
.admin-actions { display: flex; gap: 16rpx; }
.admin-action {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
}

/* 搜索框 */
.search-bar {
  position: relative;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.search-input {
  width: 100%;
  height: 72rpx;
  font-size: 26rpx;
  color: #2c2c2a;
}
.search-placeholder { color: #b0b0b0; font-size: 26rpx; }
.search-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ddd;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  display: none;
}
.search-clear.show { display: block; }

/* 角色筛选 tabs */
.filter-tabs {
  white-space: nowrap;
  margin-bottom: 12rpx;
}
.filter-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #fff;
  color: #888780;
  border-radius: 20rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}
.filter-tab-hover { background: #f5f5fa; }
.filter-tab.active {
  background: #26215C;
  color: #fff;
  font-weight: 600;
}

/* 状态筛选 chips */
.status-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.status-row-label {
  font-size: 22rpx;
  color: #888780;
  margin-right: 10rpx;
}
.status-chip {
  padding: 8rpx 20rpx;
  background: #fff;
  color: #888780;
  border-radius: 16rpx;
  margin-right: 10rpx;
  font-size: 22rpx;
}
.status-chip-hover { background: #f5f5fa; }
.status-chip.active {
  background: #FF9500;
  color: #fff;
}

/* 结果统计 */
.result-bar {
  font-size: 22rpx;
  color: #888780;
  margin-bottom: 12rpx;
}

/* 用户卡片列表 */
.user-list { margin-bottom: 16rpx; }
.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 80rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.user-avatar.student { background: linear-gradient(135deg, #534ab7, #26215C); }
.user-avatar.monitor { background: linear-gradient(135deg, #FF9500, #FF6B00); }
.user-avatar.counselor { background: linear-gradient(135deg, #07c160, #04a052); }
.user-avatar.college { background: linear-gradient(135deg, #1989fa, #0e6ddc); }
.user-avatar.dorm { background: linear-gradient(135deg, #9c27b0, #7b1fa2); }

.user-info {
  flex: 1;
  min-width: 0;
}
.user-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}
.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2c2a;
}
.role-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: #fff;
}
.role-tag.student { background: #26215C; }
.role-tag.monitor { background: #FF9500; }
.role-tag.counselor { background: #07c160; }
.role-tag.college { background: #1989fa; }
.role-tag.dorm { background: #9c27b0; }

.user-id {
  font-size: 22rpx;
  color: #888780;
  margin-bottom: 6rpx;
}
.user-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.status-dot.active { background: #07c160; }
.status-dot.disabled { background: #ccc; }
.status-text {
  font-size: 20rpx;
  color: #888780;
}

/* 操作按钮 */
.user-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}
.action-btn {
  padding: 8rpx 18rpx;
  background: #f5f5fa;
  color: #26215C;
  font-size: 22rpx;
  border-radius: 6rpx;
  text-align: center;
  min-width: 90rpx;
}
.action-btn-hover { opacity: 0.75; }
.action-btn.primary {
  background: #07c160;
  color: #fff;
}
.action-btn.danger {
  background: #fff;
  color: #e64340;
  border: 1rpx solid #e64340;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}
.empty-text {
  color: #b0b0b0;
  font-size: 26rpx;
}

.admin-footer {
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 32rpx;
}