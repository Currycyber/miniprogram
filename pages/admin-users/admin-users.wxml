<view class="admin-bg">

  <!-- 顶部欢迎条 -->
  <view class="admin-top">
    <view class="admin-greet">
      <view class="admin-avatar">U</view>
      <view class="admin-info">
        <view class="admin-name">用户与角色管理</view>
        <view class="admin-role">共 {{users.length}} 人 · 启用 {{totalActive}} · 停用 {{totalDisabled}}</view>
      </view>
    </view>
    <view class="admin-actions">
      <text class="admin-action" bindtap="goBack">看板</text>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索姓名 / 学号 / 学院"
      placeholder-class="search-placeholder"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
    />
    <text class="search-clear {{keyword ? 'show' : ''}}" bindtap="onClearKeyword">✕</text>
  </view>

  <!-- 角色筛选 -->
  <scroll-view class="filter-tabs" scroll-x="true" enhanced show-scrollbar="{{false}}">
    <view
      class="filter-tab {{roleIdx === idx ? 'active' : ''}}"
      wx:for="{{roleFilters}}" wx:key="key"
      wx:for-index="idx"
      data-idx="{{idx}}"
      bindtap="onRoleFilter"
      hover-class="filter-tab-hover"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 状态筛选 -->
  <view class="status-row">
    <text class="status-row-label">状态：</text>
    <view
      class="status-chip {{statusIdx === idx ? 'active' : ''}}"
      wx:for="{{statusFilters}}" wx:key="key"
      wx:for-index="idx"
      data-idx="{{idx}}"
      bindtap="onStatusFilter"
      hover-class="status-chip-hover"
    >{{item.label}}</view>
  </view>

  <!-- 结果统计 -->
  <view class="result-bar">筛选结果：{{filtered.length}} 人</view>

  <!-- 用户列表 -->
  <view class="user-list">
    <view class="user-card" wx:for="{{filtered}}" wx:key="id">
      <view class="user-avatar {{item.role}}">{{item.avatar}}</view>
      <view class="user-info">
        <view class="user-name-row">
          <text class="user-name">{{item.name}}</text>
          <view class="role-tag {{item.role}}">{{item.roleLabel}}</view>
        </view>
        <view class="user-id">{{item.identifier}} · {{item.college}}</view>
        <view class="user-meta">
          <view class="status-dot {{item.status}}"></view>
          <text class="status-text">{{item.status === 'active' ? '已启用' : '已停用'}}</text>
        </view>
      </view>
      <view class="user-actions">
        <view class="action-btn" data-id="{{item.id}}" bindtap="onViewDetail" hover-class="action-btn-hover">详情</view>
        <view class="action-btn {{item.status === 'active' ? 'danger' : 'primary'}}" data-id="{{item.id}}" bindtap="onToggleStatus" hover-class="action-btn-hover">
          {{item.status === 'active' ? '停用' : '启用'}}
        </view>
      </view>
    </view>

    <view wx:if="{{filtered.length === 0}}" class="empty">
      <view class="empty-icon">📭</view>
      <view class="empty-text">暂无符合条件的用户</view>
    </view>
  </view>

  <view class="admin-footer">演示数据 · 仅供答辩展示</view>

</view>