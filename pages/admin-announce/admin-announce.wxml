<view class="admin-bg">

  <!-- 顶部欢迎条 -->
  <view class="admin-top">
    <view class="admin-greet">
      <view class="admin-avatar">A</view>
      <view class="admin-info">
        <view class="admin-name">系统公告发布</view>
        <view class="admin-role">草稿 {{stats.draft}} · 已发布 {{stats.published}} · 已下线 {{stats.offline}}</view>
      </view>
    </view>
    <view class="admin-actions">
      <text class="admin-action primary" bindtap="onNew">+ 新建</text>
      <text class="admin-action" bindtap="goBack">看板</text>
    </view>
  </view>

  <!-- tab 切换 -->
  <scroll-view class="filter-tabs" scroll-x="true" enhanced show-scrollbar="{{false}}">
    <view
      class="filter-tab {{tabIdx === idx ? 'active' : ''}}"
      wx:for="{{tabs}}" wx:key="key"
      wx:for-index="idx"
      data-idx="{{idx}}"
      bindtap="onTabChange"
      hover-class="filter-tab-hover"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 公告列表 -->
  <view class="ann-list">
    <view class="ann-card" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="onViewDetail" hover-class="ann-card-hover">
      <view class="ann-header">
        <view class="ann-type type-{{item.type}}">{{item.typeLabel}}</view>
        <view class="ann-title">{{item.title}}</view>
      </view>
      <view class="ann-content">{{item.content}}</view>
      <view class="ann-meta">
        <text class="ann-author">{{item.author}}</text>
        <text class="ann-time">{{item.publishedAt || item.createdAt}}</text>
        <view class="status-pill status-{{item.status}}">
          {{item.status === 'draft' ? '草稿' : (item.status === 'published' ? '已发布' : '已下线')}}
        </view>
      </view>
      <view class="ann-actions" catchtap="onViewDetail">
        <view wx:if="{{item.status !== 'published'}}" class="action-btn primary" data-id="{{item.id}}" catchtap="onPublish">发布</view>
        <view wx:if="{{item.status === 'published'}}" class="action-btn" data-id="{{item.id}}" catchtap="onOffline">下线</view>
        <view class="action-btn danger" data-id="{{item.id}}" catchtap="onDelete">删除</view>
      </view>
    </view>

    <view wx:if="{{filtered.length === 0}}" class="empty">
      <view class="empty-icon">📭</view>
      <view class="empty-text">暂无{{tabs[tabIdx].label}}公告</view>
    </view>
  </view>

  <view class="admin-footer">演示数据 · 仅供答辩展示</view>

</view>