<view class="container">
  <view class="page-title">辅导员审核看板</view>
  <view class="page-subtitle">21思政1班 · 待审核加减分</view>

  <!-- 统计 -->
  <view class="metric-grid">
    <view class="metric-item">
      <view class="metric-label">待审核</view>
      <view class="metric-value text-warning">{{pendingCount}}</view>
    </view>
    <view class="metric-item">
      <view class="metric-label">已通过</view>
      <view class="metric-value text-success">86</view>
    </view>
    <view class="metric-item">
      <view class="metric-label">已驳回</view>
      <view class="metric-value text-danger">4</view>
    </view>
  </view>

  <!-- 审核列表 -->
  <view class="card" wx:for="{{reviews}}" wx:key="id">
    <view class="review-header">
      <text class="review-name">{{item.name}} · {{item.category}}</text>
      <text class="review-status text-warning">待审核</text>
    </view>
    <view class="review-detail">{{item.detail}}</view>
    <view class="review-evidence">凭证：{{item.evidence}}</view>
    <view class="review-btns">
      <button class="btn-reject" data-id="{{item.id}}" bindtap="reject">驳回</button>
      <button class="btn-pass" data-id="{{item.id}}" bindtap="pass">通过</button>
    </view>
  </view>
</view>
