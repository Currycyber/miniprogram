/* pages/student-announce-detail/student-announce-detail.wxss */
.container {
  padding: 0 0 80rpx 0;
  min-height: 100vh;
  background: #f7f7fa;
}

.banner {
  padding: 24rpx 32rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.banner-type {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}
.banner-read {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.header {
  background: #fff;
  padding: 32rpx;
  border-bottom: 1rpx solid #e5e5ea;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 16rpx;
}
.meta {
  display: flex;
  font-size: 24rpx;
  color: #888;
  gap: 24rpx;
}
.meta-author, .meta-time {
  display: block;
}

.priority-badge {
  display: inline-block;
  background: #fff;
  border: 2rpx solid currentColor;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin: 24rpx 32rpx 0 32rpx;
}
.priority-badge.high {
  color: #FF3B30;
}
.priority-badge.medium {
  color: #FF9500;
}

.content {
  background: #fff;
  margin-top: 24rpx;
  padding: 32rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.footer {
  background: #fff;
  margin-top: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e5e5ea;
}
.footer-line {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

.btn-share {
  margin: 40rpx 32rpx 0 32rpx;
  background: #26215c;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}
