/* pages/admin-dashboard/admin-dashboard.wxss */

.admin-bg {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx 24rpx 80rpx;
  box-sizing: border-box;
}

/* 顶部欢迎条 */
.admin-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #26215C, #534ab7);
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.admin-greet {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.admin-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  text-align: center;
  line-height: 80rpx;
  font-size: 38rpx;
  font-weight: 700;
}
.admin-name {
  font-size: 32rpx;
  font-weight: 600;
}
.admin-role {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}
.admin-actions {
  display: flex;
  gap: 24rpx;
}
.admin-action {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 8rpx;
}

/* 4 大指标 */
.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.metric-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.metric-label {
  font-size: 24rpx;
  color: #888780;
  margin-bottom: 8rpx;
}
.metric-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #26215C;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2a;
  margin-bottom: 20rpx;
}

/* 雷达图 */
.radar-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
}
.radar-canvas {
  width: 560rpx;
  height: 400rpx;
}

/* 管理模块入口 */
.module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.module-item {
  background: #f5f5fa;
  border-radius: 12rpx;
  padding: 18rpx 14rpx;
  text-align: center;
  border: 1rpx solid transparent;
  transition: all 0.15s;
}
.module-item-hover {
  background: #fff8ed;
  border-color: #FF9500;
}
.module-item.enabled {
  background: linear-gradient(135deg, #26215C 0%, #534ab7 100%);
  color: #fff;
}
.module-item.enabled .module-sub {
  color: rgba(255, 255, 255, 0.7);
}
.module-item.disabled {
  opacity: 0.55;
}
.module-icon {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  background: #534ab7;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
.module-item.enabled .module-icon {
  background: rgba(255, 255, 255, 0.18);
  color: inherit;
}
.module-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.module-sub {
  font-size: 20rpx;
  color: #888780;
}

/* 学院排名行 */
.college-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.15s;
}
.college-row:last-child {
  border-bottom: none;
}
.college-row-hover {
  background: #f5f5fa;
}
.college-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 280rpx;
}
.college-rank {
  width: 40rpx;
  height: 40rpx;
  background: #f0f0f0;
  color: #888780;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.college-name {
  font-size: 26rpx;
  color: #2c2c2a;
}
.college-name.highlighted {
  color: #26215C;
  font-weight: 600;
}
.college-bar {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}
.college-fill {
  height: 100%;
  background: linear-gradient(90deg, #534ab7, #26215C);
  border-radius: 8rpx;
  transition: width 0.4s ease, background 0.2s;
}
.college-fill.highlighted {
  background: linear-gradient(90deg, #FF9500, #FF6B00);
  box-shadow: 0 0 8rpx rgba(255, 149, 0, 0.5);
}
.college-score {
  width: 80rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2c2a;
}

/* 宿舍统计 */
.dorm-row {
  display: flex;
  gap: 16rpx;
}
.dorm-stat {
  flex: 1;
  background: #f5f5fa;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}
.dorm-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #26215C;
}
.dorm-label {
  font-size: 22rpx;
  color: #888780;
  margin-top: 6rpx;
}

.admin-footer {
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 32rpx;
}