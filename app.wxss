/* app.wxss 全局样式 */

page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #2c2c2a;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #eeeeee;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 标题 */
.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c2c2a;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: #888780;
  margin-bottom: 28rpx;
}

/* 指标卡片 */
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.metric-item {
  flex: 1;
  min-width: 200rpx;
  background: #f1efe8;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.metric-label {
  font-size: 24rpx;
  color: #888780;
}

.metric-value {
  font-size: 44rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

/* 按钮 */
.btn-primary {
  background: #26215c;
  color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: #26215c;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: 1rpx solid #26215c;
}

.btn-outline::after {
  border: none;
}

/* 主色文本 */
.text-primary { color: #26215c; }
.text-success { color: #1d9e75; }
.text-danger { color: #e24b4a; }
.text-warning { color: #ba7517; }
.text-muted { color: #888780; }

/* 分隔 */
.divider {
  height: 1rpx;
  background: #eeeeee;
  margin: 20rpx 0;
}
